<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <application>
        <service
            android:name=".MediaExportService"
            android:exported="false"
            android:foregroundServiceType="mediaProcessing|dataSync"
            android:stopWithTask="false" />

        <provider
            android:name="com.onetake.media.MediaFileProvider"
            android:authorities="${applicationId}.oneTakeMedia.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/one_take_media_file_paths" />
        </provider>
    </application>
</manifest>
