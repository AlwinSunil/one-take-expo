<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <application>
    <service android:name=".ExportService" android:exported="false" android:foregroundServiceType="mediaProcessing|dataSync" />
    <provider android:name=".ResearchFileProvider" android:authorities="${applicationId}.onetake.media.research" android:exported="false" android:grantUriPermissions="true">
      <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/onetake_media_research_paths" />
    </provider>
  </application>
</manifest>
